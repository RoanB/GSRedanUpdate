<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<title>{% trans "New message from the contact form" %}</title>
	</head>
	<body style="font-family: sans-serif; font-size: 15px; line-height: 1.5; color: #212529;">
		{% if copy %}
			<p>{% trans "Here is a copy of the message you sent through gsredan.be:" %}</p>
		{% else %}
			<p>{% trans "A visitor wrote through the contact form on gsredan.be:" %}</p>
		{% endif %}

		<p>
			<strong>{{ name }}</strong>
			&lt;{{ email }}&gt;<br>
			{% trans "Topic" %}: {% if topic == 'club' %}{% trans "Join the club" %}{% elseif topic == 'youth' %}{% trans "Youth program" %}{% elseif topic == 'reserve' %}{% trans "Reserve the training area" %}{% elseif topic == 'rally' %}{% trans "Rally" %} {{ year }}{% else %}{% trans "Something else" %}{% endif %}
		</p>

		<p style="white-space: pre-line;">{{ message }}</p>

		{% if copy %}
			<p style="font-size: 13px; color: #6c757d;">
				{% trans "You receive this copy because you filled in the contact form on gsredan.be." %}
			</p>
		{% else %}
			<p style="font-size: 13px; color: #6c757d;">
				{% trans "Reply to this mail to answer the visitor directly." %}
			</p>
		{% endif %}
	</body>
</html>
