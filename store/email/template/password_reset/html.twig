<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<title>{% trans "Reset your password" %}</title>
	</head>
	<body style="font-family: sans-serif; font-size: 15px; line-height: 1.5; color: #212529;">
		<p>{% trans "Hello" %},</p>

		<p>
			{% trans "Someone asked to reset the password of your GS Redan account." %}
		</p>

		<p>
			{% trans "Open the link below to choose a new password. If you did not ask for this, you can ignore this email: your current password stays valid." %}
		</p>

		<p>
			<a href="{{ reset_url }}" style="background-color: #206bc4; color: #ffffff; padding: 10px 18px; text-decoration: none; display: inline-block;">{% trans "Choose a new password" %}</a>
		</p>

		<p style="font-size: 13px; color: #6c757d;">
			{% trans "The link is only valid once, and expires 24 hours after this email was sent." %}
		</p>

		<p style="font-size: 13px; color: #6c757d;">
			{% trans "If the button does not work, copy this address into your browser:" %}<br>
			<a href="{{ reset_url }}">{{ reset_url }}</a>
		</p>

		<p style="font-size: 13px; color: #6c757d;">{% trans "GS Redan" %}</p>
	</body>
</html>
