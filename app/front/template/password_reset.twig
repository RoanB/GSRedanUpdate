{% extends "_default/layout.login.twig" %}
{% import "_default/macro.tabler.twig" as tabler %}

{% block content %}
	<div class="card card-md">
		<div class="card-body">
			{% if token_valid == false %}
				<h2 class="h2 text-center mb-4">{% trans "Link not valid" %}</h2>
				{{ tabler.alert('danger', 'This reset link is no longer valid.'|trans, 'Links work once and expire after 24 hours.'|trans) }}
				<div>
					<a href="/login" class="btn btn-primary w-100">{% trans "Back to login" %}</a>
				</div>
			{% else %}
				<h2 class="h2 text-center mb-4">{% trans "New password" %}</h2>
				<p class="text-secondary">{% trans "Hello" %} {{ user_name }}, {% trans "choose a new password for your account." %}</p>
				{% if errors is defined and errors|length > 0 %}
					{{ tabler.alert('danger', 'Please fix the errors'|trans, tabler.show_errors(errors)) }}
				{% endif %}
				<form method="post" action="/login?action=reset_password" autocomplete="off">
					<input type="hidden" name="token" value="{{ token }}">
					<div class="mb-3">
						<label class="form-label">{% trans "New password" %}</label>
						<div class="input-group input-group-flat">
							<input type="password" name="password" id="reset_password" class="form-control" autocomplete="new-password" minlength="8" required autofocus>
							<span class="input-group-text">
								<a href="#" class="link-secondary" data-toggle-password="#reset_password" title="{% trans "Show password" %}" aria-label="{% trans "Show password" %}">
									<svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/><path d="M21 12c-2.4 4.5-6.2 7-9 7s-6.6-2.5-9-7c2.4-4.5 6.2-7 9-7s6.6 2.5 9 7"/></svg>
								</a>
							</span>
						</div>
						<small class="form-hint">{% trans "At least 8 characters." %}</small>
					</div>
					<div class="mb-3">
						<label class="form-label">{% trans "Repeat new password" %}</label>
						<input type="password" name="password_repeat" class="form-control" autocomplete="new-password" minlength="8" required>
					</div>
					<div>
						<button type="submit" class="btn btn-primary w-100">
							{% trans "Save new password" %}
						</button>
					</div>
				</form>
			{% endif %}
		</div>
	</div>
{% endblock content %}
