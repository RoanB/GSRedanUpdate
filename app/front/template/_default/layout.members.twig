{% import "_default/macro.tabler.twig" as tabler %}
<!DOCTYPE html>
<html lang="{{ env.session.language.name_short }}">
<head>
	<title>{% block header_title %}{% endblock header_title %}</title>

	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">

	<link rel="icon" href="/favicon.ico?v=20260918a" type="image/x-icon"/>
	<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=20260918a" />
	<link rel="icon" type="image/jpeg" href="/favicon.jpg?v=20260918a" />
	<link rel="apple-touch-icon" href="/favicon.jpg?v=20260918a" />

	<link rel="stylesheet" href="/tabler--core/dist/css/tabler.min.css" />
	<link rel="stylesheet" href="/base.css?v=20261001h" />

	{% block header_css %}{% endblock header_css %}
</head>
<body>
	<div class="page">
		{% if environment != 'production' %}
			<div class="alert alert-warning text-center mb-0 rounded-0" role="alert">
				<strong>{% trans 'Notice' %}</strong>: {% trans 'You are currently working in a test environment.' %}
			</div>
		{% endif %}
		{% if show_gate is not defined or show_gate == false %}
		<header class="navbar navbar-expand-md d-print-none">
			<div class="container-xl">
				<button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="{% trans "Toggle navigation" %}">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
					<a href="/" class="d-flex align-items-center gap-2">
						<img src="/logo.webp" alt="" class="navbar-brand-image" />
						<span>GS Redan</span>
					</a>
				</div>
				<div id="navbar-menu" class="collapse navbar-collapse">
					<ul class="navbar-nav">
						<li class="nav-item">
							<a class="nav-link{% if members_tab is defined and members_tab == 'files' %} active{% endif %}" href="/members">
								<span class="nav-link-title">{{ tabler.icon('download') }} {% trans "Files" %}</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link{% if members_tab is defined and members_tab == 'calendar' %} active{% endif %}" href="/members/calendar">
								<span class="nav-link-title">{{ tabler.icon('calendar') }} {% trans "Calendar" %}</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link{% if user is defined %} d-none{% else %} d-block{% endif %}" href="/login">
								<span class="nav-link-title">{{ tabler.icon('settings') }} {% trans "Admin" %}</span>
							</a>
						</li>
					</ul>
				</div>
				{% if user is defined %}
					<ul class="navbar-nav flex-row order-md-last align-items-center">
						<li class="nav-item">
							<a class="nav-link" href="/login?action=logout">
								<span class="nav-link-title">{{ tabler.icon('logout') }} {% trans "Log out" %}</span>
							</a>
						</li>
					</ul>
				{% endif %}
			</div>
		</header>
		{% endif %}
		<div class="page-wrapper">
			{% if show_gate is not defined or show_gate == false %}
				<div class="page-header d-print-none">
					<div class="container-xl">
						<div class="row g-2 align-items-center">
							<div class="col">
								<h2 class="page-title">{% if members_tab is defined and members_tab == 'calendar' %}{% trans "Calendar" %}{% else %}{% trans "Members area" %}{% endif %}</h2>
							</div>
						</div>
					</div>
				</div>
			{% endif %}
			<div class="page-body">
				<div class="container-xl">
					{% block content %}{% endblock content %}
				</div>
			</div>
		</div>
	</div>
	<footer class="footer footer-transparent footer-sticky d-print-none">
		<div class="container-xl">
			<div class="row text-center align-items-center flex-row-reverse">
				<div class="col-lg-auto ms-lg-auto">
					<ul class="list-inline list-inline-dots mb-0">
						<li class="list-inline-item">
							{# Language URLs mirror the current path with a language
							   prefix (/fr/members -> /nl/members). An unprefixed
							   path gets the prefix appended. Same logic as the
							   public navbar. #}
							{% set request_segments = (env.server.REQUEST_URI|split('?')|first)|split('/') %}
							{% set language_shorts = [] %}
							{% for language in languages %}
								{% set language_shorts = language_shorts|merge([ language.name_short ]) %}
							{% endfor %}
							{% if request_segments[1] in language_shorts %}
								{% set base_segments = request_segments|slice(2) %}
							{% else %}
								{% set base_segments = request_segments|slice(1) %}
							{% endif %}
							{% set language_urls = {} %}
							{% for language in languages %}
								{% set language_segments = [ '', language.name_short ]|merge(base_segments) %}
								{% set language_urls = language_urls|merge({ (language.name_short): language_segments|join('/') }) %}
							{% endfor %}
							{% for language in languages %}
								{% if language.id == env.session.language.id %}
									<strong>{{ language.name_short|upper }}</strong>
								{% else %}
									<a class="link-secondary" href="{{ language_urls[language.name_short] }}" lang="{{ language.name_short }}">{{ language.name_short|upper }}</a>
								{% endif %}
								{% if loop.last == false %} - {% endif %}
							{% endfor %}
						</li>
					</ul>
				</div>
			</div>
		</div>
	</footer>
	<script src="/tabler--core/dist/js/tabler.min.js"></script>
	{% block footer_scripts %}{% endblock footer_scripts %}
	<script src="/base.js?v=20261001b"></script>
</body>
</html>