	{% set path = icon_paths[name] is defined ? icon_paths[name] : icon_paths['file'] %}
	<svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler{% if class is not empty %} {{ class }}{% endif %}" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ path|raw }}</svg>
