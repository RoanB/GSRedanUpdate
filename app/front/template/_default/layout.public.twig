	<link rel="preload" as="font" type="font/woff2" crossorigin
		href="https://fonts.gstatic.com/s/nunito/v32/XRXV3I6Li01BKofINeaB.woff2">
	<link rel="preload" as="font" type="font/woff2" crossorigin
		href="https://fonts.gstatic.com/s/baloo2/v23/wXKrE3kTposypRyd51jcAA.woff2">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/styles.css?v=20261019e" rel="stylesheet">
	{# Page-specific head: canonical, Open Graph/Twitter, JSON-LD and the LCP
	   hero preloads live on the page templates — they are the only things
	   that differ between the pages, everything above is shared chrome. #}
	{% block page_head %}{% endblock page_head %}
</head>

<body data-page="{% block body_page %}home{% endblock body_page %}">
	<a class="skip-link" href="#main-content">{% trans 'Skip to content' %}</a>

{# The nav and the footer are page chrome: identical markup on every page,
   only the active link and the solid state differ. They are skipped on the
   error pages (body data-page="e404" has neither in ../gsredanupdate/404.html:
   a 404 that offers the full navigation reads as a working page). #}
{% if error_page is not defined %}
	{% set request_segments = (env.server.REQUEST_URI|split('?')|first)|split('/') %}
	{# Language URLs mirror the current path with a language prefix
	   (/about/ -> /nl/about/). An unprefixed path gets the prefix appended. #}
	{% set language_shorts = [] %}
	{% for language in languages %}
		{% set language_shorts = language_shorts|merge([ language.name_short ]) %}
	{% endfor %}
	{% if request_segments[1] in language_shorts %}
		{% set base_segments = request_segments|slice(2) %}
	{% else %}
		{% set base_segments = request_segments|slice(1) %}
	{% endif %}
	{% set language_urls = {} %}
	{% for language in languages %}
		{% set language_segments = [ '', language.name_short ]|merge(base_segments) %}
		{% set language_urls = language_urls|merge({ (language.name_short): language_segments|join('/') }) %}
	{% endfor %}
	{# Current page: first path segment after an optional language prefix.
	   Drives aria-current on the links and the navbar-solid state (the two
	   pages that open on a cream hero instead of a photo carry navbar-solid
	   so the bar starts readable). #}
	{% if request_segments[1] in language_shorts %}
		{% set current_page = request_segments[2] ?? '' %}
	{% else %}
		{% set current_page = request_segments[1] ?? '' %}
	{% endif %}

	<!-- Navigation -->
	<header>
		<nav class="navbar navbar-expand-lg fixed-top{% if current_page == 'about' or current_page == 'legal' %} navbar-solid{% endif %}" id="mainNav" aria-label="{% trans 'Main navigation' %}">
			<div class="container">
				<a class="navbar-brand" href="/">
					<img src="/logo.webp" alt="{% trans 'logo GS Redan' %}" width="30" height="40">
					<span>GS Redan</span>
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse"
					data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false"
					aria-label="{% trans 'Open menu' %}" data-menu-close="{% trans 'Close menu' %}">
					<svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M4 6l16 0" /> <path d="M4 12l16 0" /> <path d="M4 18l16 0" /></svg>
				</button>
				<div class="collapse navbar-collapse" id="navbarResponsive">
					<ul class="navbar-nav ms-auto align-items-lg-center">
						<li class="nav-item"><a class="nav-link" href="/"{% if current_page == '' %} aria-current="page"{% endif %}>{% trans 'Home' %}</a></li>
						<li class="nav-item"><a class="nav-link" href="/about/"{% if current_page == 'about' %} aria-current="page"{% endif %}>{% trans 'About us' %}</a></li>
{% if settings.rally_enabled %}
						<li class="nav-item"><a class="nav-link" href="/rallye/"{% if current_page == 'rallye' %} aria-current="page"{% endif %}>{% trans 'Rally' %} {{ rally_year }}</a></li>
{% endif %}
						<li class="nav-item"><a class="nav-link" href="/#contact">{% trans 'Contact' %}</a></li>
						<li class="nav-item dropdown d-none d-lg-block">
							<button type="button" class="nav-link lang-toggle dropdown-toggle"
								id="language-selector" data-bs-toggle="dropdown" aria-expanded="false"
								aria-haspopup="true">
								<svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /> <path d="M3.6 9h16.8" /> <path d="M3.6 15h16.8" /> <path d="M11.5 3a17 17 0 0 0 0 18" /> <path d="M12.5 3a17 17 0 0 1 0 18" /></svg>
								<span>{% trans 'Language' %}</span>
							</button>
							<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="language-selector">
{% set language_labels = { 'fr': 'Français'|trans, 'en': 'English'|trans, 'nl': 'Nederlands'|trans } %}
{% for language in languages %}
								<li><a class="dropdown-item lang-btn{% if language.name_short == env.session.language.name_short %} active{% endif %}" href="{{ language_urls[language.name_short] }}" lang="{{ language.name_short }}"{% if language.name_short == env.session.language.name_short %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ language_labels[language.name_short] }}</a></li>
{% endfor %}
							</ul>
						</li>
						<li class="nav-item d-lg-none w-100">
							<div class="lang-pills" role="group" aria-label="{% trans 'Language choice' %}">
{% for language in languages %}
								<a class="lang-btn{% if language.name_short == env.session.language.name_short %} active{% endif %}" href="{{ language_urls[language.name_short] }}" lang="{{ language.name_short }}"{% if language.name_short == env.session.language.name_short %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ language.name_short|upper }}</a>
{% endfor %}
							</div>
						</li>
					</ul>
				</div>
			</div>
		</nav>
	</header>
{% endif %}

	<main id="main-content">
{% block content %}{% endblock content %}
	</main>

{% if error_page is not defined %}
	<!-- Footer -->
	<footer class="footer">
		<div class="container">
			<div class="row g-4">
				<div class="col-lg-5">
					<p class="footer-brandline"><img src="/logo.webp" alt="{% trans 'logo GS Redan' %}" width="30" height="40" loading="lazy">GS Redan</p>
					<p class="mb-3">{% trans 'Caving club located in Brussels, with a training facility underneath the Basilica.' %}</p>
					<div class="d-flex flex-wrap gap-3 mt-4 mb-4">
						<a class="btn-yellow" href="/members"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /> <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /> <path d="M16 3.13a4 4 0 0 1 0 7.75" /> <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" /></svg> <span>{% trans 'Members' %}</span></a>
						<a class="btn-ghost-light" href="/admin"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M5 11l0 8a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-8a2 2 0 0 0 -2 -2h-10a2 2 0 0 0 -2 2z" /> <path d="M8 11v-4a4 4 0 1 1 8 0v4" /> <path d="M12 15m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /></svg> <span>{% trans 'Admin' %}</span></a>
					</div>
					<p class="mb-0 fw-bold">{% trans 'Follow our adventures' %}</p>
					<div class="d-flex gap-3 mt-2">
						<a class="social-btn on-dark" href="{{ settings.social_instagram }}" target="_blank"
