{% extends "_default/layout.base.twig" %}
{% import "_default/macro.tabler.twig" as tabler %}

{% block header_title %}{% trans "Cards" %}{% endblock header_title %}
{% block header_breadcrumb %}
	<li class="breadcrumb-item active">{% trans "Cards" %}</li>
{% endblock header_breadcrumb %}

{% block content %}
	{% if env.get.saved is defined %}
		{{ tabler.alert('success', 'Saved'|trans) }}
	{% endif %}
	{% if env.get.add_failed is defined %}
		{{ tabler.alert('danger', 'Card could not be added'|trans) }}
	{% endif %}
	{% if env.get.deleted is defined %}
		{{ tabler.alert('success', 'Card deleted'|trans) }}
	{% endif %}
	{% if env.get.delete_failed is defined %}
		{{ tabler.alert('danger', 'Card could not be deleted: fixed cards (masthead, club, contact, Monday openings) are part of the page structure.'|trans) }}
	{% endif %}

	<div class="card">
		<div class="card-header">
			<div>
				<h3 class="card-title">{% trans "Homepage cards" %}</h3>
				<div class="card-subtitle mt-1">
					{% trans "Every row is one section of the one-pager. Drag a row by the handle to reorder; the site menu (only blocks with an anchor and a menu label in the current language) follows this order. The footer is fixed page chrome and no longer appears here." %}
				</div>
			</div>
		</div>
		<div class="table-responsive">
			<table class="table table-vcenter card-table" id="sortable-table" data-sort-url="/admin/block?action=order">
				<thead>
					<tr>
						<th></th>
						<th>{{ tabler.icon('info-circle') }} {% trans "Card" %}</th>
						<th>{% trans "Anchor (menu link)" %}</th>
						<th>{% trans "Menu label" %}</th>
						<th>{% trans "Visible" %}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for block in blocks %}
						<tr data-id="{{ block.id }}" class="sortable-row{% if not block.draggable %} non-draggable{% endif %}">
							<td>
								{% if block.draggable %}
									<span class="text-secondary cursor-grab">{{ tabler.icon('grip-vertical') }}</span>
								{% else %}
									<span class="text-secondary" data-bs-toggle="tooltip" data-bs-title="{{ "The masthead is the fixed hero of the page and cannot be moved."|trans }}">{{ tabler.icon('lock') }}</span>
								{% endif %}
							</td>
							<td>
								{% if block.kind == 'fixed' %}
									<span class="badge bg-blue-lt me-1" data-bs-toggle="tooltip" data-bs-title="{{ "This fixed singular card renders with its own layout and cannot be duplicated or deleted."|trans }}">{{ tabler.icon('lock') }} {{ block.type_label }}</span>
								{% elseif block.kind == 'card' %}
									<span class="badge bg-green-lt me-1" data-bs-toggle="tooltip" data-bs-title="{{ "Generic card: create and reorder more of these."|trans }}">{{ block.type_label }}</span>
								{% else %}
									<span class="badge bg-secondary-lt me-1" data-bs-toggle="tooltip" data-bs-title="{{ "Pre-generics type that still renders; edit content as usual."|trans }}">{{ block.type_label }}</span>
								{% endif %}
								{{ block.type }}
							</td>
							<td>{% if block.anchor %}<code>#{{ block.anchor }}</code>{% else %}<span class="text-secondary">{% trans "none" %}</span>{% endif %}</td>
							<td>{{ block.title }}</td>
							<td>
								<button type="button" class="btn btn-sm {% if block.visible %}btn-success{% else %}btn-outline-secondary{% endif %} visibility-toggle" data-visibility-url="/admin/block?action=visibility" data-id="{{ block.id }}" data-label-on="{% trans "On" %}" data-label-off="{% trans "Off" %}">
									{% if block.visible %}{% trans "On" %}{% else %}{% trans "Off" %}{% endif %}
								</button>
							</td>
							<td class="text-end">
								<a class="btn btn-sm btn-outline-primary" href="/admin/block?action=edit&amp;id={{ block.id }}">
									{{ tabler.icon('edit') }} {% trans "Edit card" %}
								</a>
								{% if block.kind != 'fixed' %}
									<a class="btn btn-sm btn-outline-danger delete-confirm" href="/admin/block?action=delete&amp;id={{ block.id }}" data-confirm-message="{% trans "Delete this card (with its content, pictures and menu entry)?" %}">
										{{ tabler.icon('trash') }} {% trans "Delete" %}
									</a>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		<div class="card-footer">
			<form method="post" action="/admin/block?action=add" class="row g-3 align-items-end">
				<div class="col-auto">
					<label class="form-label mb-0">{% trans "New card type" %}</label>
					<select name="type" class="form-select">
						{% for type in creatable_types %}
							<option value="{{ type.key }}">{{ type.label }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="col-auto">
					<button type="submit" class="btn btn-primary">{{ tabler.icon('plus') }} {% trans "Add card" %}</button>
				</div>
				<div class="col">
					<span class="form-hint d-block">{% trans "Activity card → one image + text section (light or dark background). 2-row card → two welded image + text sections on a single card. Gallery card → a free amount of pictures with a lightbox. Announcement card → highlighted news banner. New cards start hidden at the bottom of the page." %}</span>
				</div>
			</form>
		</div>
	</div>
{% endblock content %}
