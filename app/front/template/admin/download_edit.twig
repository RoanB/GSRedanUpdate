{% extends "_default/layout.base.twig" %}
{% import "_default/macro.tabler.twig" as tabler %}

{% set is_edit = download_file is defined and download_file is not empty %}

{% block header_title %}{% if is_edit %}{% trans "Edit download" %}{% else %}{% trans "Add download" %}{% endif %}{% endblock header_title %}
{% block header_breadcrumb %}
	<li class="breadcrumb-item"><a href="/admin/download">{% trans "Downloads" %}</a></li>
	<li class="breadcrumb-item active">{% if is_edit %}{{ download_file.name }}{% else %}{% trans "New" %}{% endif %}</li>
{% endblock header_breadcrumb %}

{% block content %}
	{% if errors is defined and errors|length > 0 %}
		{{ tabler.alert('danger', 'Please fix the errors'|trans, tabler.show_errors(errors)) }}
	{% endif %}
	<form method="post" enctype="multipart/form-data" action="/admin/download?action=edit{% if is_edit %}&amp;id={{ download_file.id }}{% endif %}">
		<div class="row">
			<div class="col-lg-8">
				<div class="card">
					<div class="card-body">
						<div class="mb-3">
							<label class="form-label required">{% trans "Display name" %}</label>
							<input type="text" name="name" class="form-control" value="{{ is_edit ? download_file.name : '' }}" required>
						</div>
					<div class="mb-3">
						<label class="form-label{% if is_edit == false %} required{% endif %}">{% trans "File" %}</label>
						<input type="file" name="file" class="form-control"{% if is_edit == false %} required{% endif %}>
						{% if is_edit %}
							<small class="form-hint">{% trans "Current file:" %} {{ download_file.get_file().name }} — {% trans "leave empty to keep it." %}</small>
						{% endif %}
					</div>
					<div class="mb-3">
						<label class="form-label">{% trans "Category" %}</label>
						<select name="download_category_id" class="form-select">
							<option value="0"{% if download_file.download_category_id is not defined or download_file.download_category_id is empty %} selected{% endif %}>{% trans "No category" %}</option>
							{% for category in categories %}
								<option value="{{ category.id }}"{% if download_file.download_category_id == category.id %} selected{% endif %}>{{ category.name }}</option>
							{% endfor %}
						</select>
						<small class="form-hint">{% trans "Files of one category are grouped on the members page." %}</small>
					</div>
						<label class="form-check">
							<input type="checkbox" class="form-check-input" name="visible" value="1"{% if is_edit == false or download_file.visible %} checked{% endif %}>
							<span class="form-check-label">{% trans "Visible" %}</span>
						</label>
					</div>
					<div class="card-footer">
						<button type="submit" class="btn btn-primary">{{ tabler.icon('save') }} {% trans "Save" %}</button>
						<a class="btn btn-link" href="/admin/download">{% trans "Cancel" %}</a>
					</div>
				</div>
			</div>
		</div>
	</form>
{% endblock content %}