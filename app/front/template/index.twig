{% extends "_default/layout.public.twig" %}

{% block page_head %}
	<link rel="canonical" href="https://www.gsredan.be/">
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="GS Redan">
	<meta property="og:title" content="{% trans 'GS Redan — Caving club in Brussels, training under the Basilica' %}">
	<meta property="og:description"
		content="{% trans 'GS Redan, one of Belgium’s largest caving clubs: training beneath the Koekelberg Basilica, a youth programme, camps and the famous Rally. Join us!' %}">
	<meta property="og:image" content="https://www.gsredan.be/caving-banner.webp">
	<meta property="og:url" content="https://www.gsredan.be/">
	<meta property="og:locale" content="fr_BE">
	<meta property="og:locale:alternate" content="nl_BE">
	<meta property="og:locale:alternate" content="en_GB">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{% trans 'GS Redan — Caving club in Brussels, training under the Basilica' %}">
	<meta name="twitter:description"
		content="{% trans 'GS Redan, one of Belgium’s largest caving clubs: training beneath the Koekelberg Basilica, a youth programme, camps and the famous Rally. Join us!' %}">
	<meta name="twitter:image" content="https://www.gsredan.be/caving-banner.webp">
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "SportsOrganization",
		"name": "Groupe Spéléo du Redan",
		"alternateName": "GS Redan",
		"url": "https://www.gsredan.be/",
		"logo": "https://www.gsredan.be/logo.webp",
		"sport": "Speleology",
		"description": "{% trans 'GS Redan, one of Belgium’s largest caving clubs: training beneath the Koekelberg Basilica, a youth programme, camps and the famous Rally.' %}",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "Bd de Smet de Naeyer 21",
			"postalCode": "1090",
			"addressLocality": "Jette",
			"addressCountry": "BE"
		},
		"sameAs": [
			"{{ settings.social_facebook }}",
			"{{ settings.social_instagram }}"
		]
	}
	</script>
	<!-- Preload the LCP hero background per viewport -->
	<link rel="preload" as="image" href="/caving-banner-tiny.webp" media="(max-width: 767.98px)"
		fetchpriority="high">
	<link rel="preload" as="image" href="/caving-banner-mid.webp" media="(min-width: 768px)"
		fetchpriority="high">
	<link rel="preload" as="image" href="/caving-banner.webp" media="(min-width: 1920px)"
		fetchpriority="high">
{% endblock page_head %}

{% block content %}

		<!-- Hero -->
		<section class="hero" id="top" aria-labelledby="hero-title">
			<div class="container">
				<p class="sticker sticker-lg">{% trans 'Caving club · Brussels' %}</p>
				<h1 id="hero-title">GS Redan</h1>
				<p class="hero-tagline">{% trans 'Caving club located in Brussels, with a training facility underneath the Basilica.' %}</p>
				<div class="hero-ctas">
					<a class="btn-yellow" href="#contact" data-topic="club"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M10 14l11 -11" /> <path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" /></svg>
						<span>{% trans 'Join the club' %}</span></a>
{% if settings.rally_enabled %}
					<a class="btn-ghost-light" href="/rallye/"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M3 19a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /> <path d="M19 7a2 2 0 1 0 0 -4a2 2 0 0 0 0 4z" /> <path d="M11 19h5.5a3.5 3.5 0 0 0 0 -7h-8a3.5 3.5 0 0 1 0 -7h4.5" /></svg>
						<span>{% trans 'The Rally' %} {{ rally_year }}</span></a>
{% endif %}
				</div>
{% if settings.rally_enabled %}
				<div class="countdown" data-countdown data-target="{{ settings.rally_start_date|replace({' ': 'T'}) }}" role="timer" aria-label="{% trans 'Countdown to the Rally' %}">
					<span class="cd-label"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M4 5m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" /> <path d="M16 3l0 4" /> <path d="M8 3l0 4" /> <path d="M4 11l16 0" /> <path d="M8 15h2v2h-2z" /></svg><span>{% trans 'Rally' %} {{ rally_year }} {% trans 'in' %}</span></span>
					<span class="cd-cells">
						<span class="cd-cell"><span class="cd-num" data-cd="d">–</span><span class="cd-unit"
								data-cd-unit="d">{% trans 'days' %}</span></span>
						<span class="cd-cell"><span class="cd-num" data-cd="h">–</span><span class="cd-unit"
								data-cd-unit="h">{% trans 'hours' %}</span></span>
						<span class="cd-cell"><span class="cd-num" data-cd="m">–</span><span class="cd-unit"
								data-cd-unit="m">{% trans 'min' %}</span></span>
						<span class="cd-cell"><span class="cd-num" data-cd="s">–</span><span class="cd-unit"
								data-cd-unit="s">{% trans 'sec' %}</span></span>
					</span>
					<span class="cd-done" hidden>{% trans 'It’s happening — see you at the Basilica!' %}</span>
				</div>
{% endif %}
			</div>
			<a class="hero-scroll" href="#club"><span>{% trans 'Abseil into the page' %}</span><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M6 9l6 6l6 -6" /></svg></a>
		</section>

		<!-- The club -->
		<section class="section section-cream" id="club" aria-labelledby="club-title">
			<div class="container">
				<div class="row justify-content-center text-center">
					<div class="col-lg-9">
						<p class="sticker sec-badge">{% trans 'The club' %}</p>
						<h2 class="sec-title mx-auto" id="club-title">{% trans 'Big ropes, a big basilica' %}</h2>
						<p class="sec-lead mx-auto">{% trans 'Groupe Spéléo du Redan is one of the largest caving clubs in Belgium. The club has a training facility located in the basement of the Koekelberg Basilica and also runs an active youth program. And sometimes, the entire basilica becomes our playground — see below.' %}</p>
					</div>
				</div>
				<div class="row g-3 g-md-4 mt-2">
					<div class="col-6 col-lg-3 reveal">
						<div class="stat">
							<span class="stat-v sm">{% trans 'Tuesday · 8 pm' %}</span>
							<span class="stat-l">{% trans 'members’ training, under the Basilica' %}</span>
						</div>
					</div>
					<div class="col-6 col-lg-3 reveal reveal-d1">
						<div class="stat">
							<span class="stat-v sm">{% trans 'Wednesday' %}</span>
							<span class="stat-l">{% trans 'caving lessons for youth, during the school year' %}</span>
						</div>
					</div>
					<div class="col-6 col-lg-3 reveal reveal-d2">
						<div class="stat">
							<span class="stat-v">2</span>
							<span class="stat-l">{% trans 'camps a year, autumn and spring' %}</span>
						</div>
					</div>
					<div class="col-6 col-lg-3 reveal reveal-d3">
						<div class="stat">
							<span class="stat-v">1</span>
							<span class="stat-l">{% trans 'basilica to climb, right in Brussels' %}</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<div class="container" aria-hidden="true">
			<hr class="rope-divider">
		</div>

		<!-- Activities -->
		<section class="section section-paper" id="activities" aria-labelledby="activities-title">
			<div class="container">
				<div class="text-center mb-5">
					<p class="sticker sticker-orange sec-badge">{% trans 'What we do' %}</p>
					<h2 class="sec-title mx-auto" id="activities-title">{% trans 'Four ways to end up upside down' %}</h2>
					<p class="sec-lead mx-auto">{% trans 'From the hall under the Basilica to the walls of the Rally: something for every level — and every head (helmet included).' %}</p>
				</div>
				<div class="row g-4">
					<!-- Club training -->
					<article class="col-12 col-md-6 col-lg-4 reveal">
						<div class="act-card">
							<div class="act-media">
								<span class="sticker">{% trans 'Members' %}</span>
								<img src="/salle.webp" width="800" height="534" loading="lazy"
									decoding="async" alt="{% trans 'Club members training on ropes in the hall beneath the Basilica' %}"
									onerror="this.onerror=null;this.src='/img-fallback.svg';">
							</div>
							<div class="act-body">
								<h3><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /> <path d="M12 7v5l3 3" /></svg><span>{% trans 'Club training' %}</span></h3>
								<p>{% trans 'Club members can train every Tuesday evening from 8:00 PM in the training facility beneath the basilica. In addition, two camps are organised each year during the Autumn and Spring holidays (French-speaking school terms). For more information or to become a member, please use the contact form.' %}</p>
								<a class="act-link" href="#contact" data-topic="club"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M5 12l14 0" /> <path d="M15 16l4 -4" /> <path d="M15 8l4 4" /></svg><span>{% trans 'Write to the club' %}</span></a>
							</div>
						</div>
					</article>
					<!-- Youth -->
					<article class="col-12 col-md-6 col-lg-4 reveal reveal-d1">
						<div class="act-card">
							<div class="act-media">
								<span class="sticker sticker-green">{% trans 'Young cavers' %}</span>
								<img src="/tower.webp" width="800" height="613" loading="lazy"
									decoding="async" alt="{% trans 'A caver seen from the bottom of a brick shaft, silhouetted against the light' %}"
									onerror="this.onerror=null;this.src='/img-fallback.svg';">
							</div>
							<div class="act-body">
								<h3><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M22 9l-10 -4l-10 4l10 4l10 -4v6" /> <path d="M6 10.6v5.4a6 3 0 0 0 12 0v-5.4" /></svg><span>{% trans 'Youth program' %}</span></h3>
								<p>{% trans 'Groupe Spéléo du Redan offers caving lessons with an emphasis on SRT for youth every Wednesday afternoon during the school year. Young participants who have mastered the basic techniques are invited to join the club’s camps during the Autumn and Spring holidays (according to the French-speaking school calendar). For more information or to register for the youth program, please use the contact form.' %}</p>
								<a class="act-link" href="#contact" data-topic="youth"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M5 12l14 0" /> <path d="M15 16l4 -4" /> <path d="M15 8l4 4" /></svg><span>{% trans 'Write to the club' %}</span></a>
							</div>
						</div>
					</article>
					<!-- Public openings -->
					<article class="col-12 col-md-6 col-lg-4 reveal reveal-d2">
						<div class="act-card dates-card">
							<div class="dates-head">
								<span class="sticker sticker-cream">{% trans 'Open to all*' %}</span>
								<h3 class="mt-2 mb-0"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M4 5m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" /> <path d="M16 3l0 4" /> <path d="M8 3l0 4" /> <path d="M4 11l16 0" /> <path d="M8 15h2v2h-2z" /></svg><span>{% trans 'Odd Mondays' %}</span></h3>
							</div>
							<div class="dates-body">
								<p class="mb-0">{% trans 'Training sessions on odd Mondays, from 7.30 pm to 10.30 pm.' %}</p>
{% if openings|length > 0 %}
								<div>
									<p class="fw-bold mb-2">{% trans 'Upcoming openings:' %}</p>
									<div class="date-chips">
{% for opening in openings %}
										<span class="date-chip"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M4 5m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" /> <path d="M16 3l0 4" /> <path d="M8 3l0 4" /> <path d="M4 11l16 0" /> <path d="M8 15h2v2h-2z" /></svg><span>{{ opening }}</span></span>
{% endfor %}
									</div>
								</div>
{% endif %}
								<div class="open-meta">
									<span class="date-chip"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M15 5l0 2" /> <path d="M15 11l0 2" /> <path d="M15 17l0 2" /> <path d="M5 5h14a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-3a2 2 0 0 0 0 -4v-3a2 2 0 0 1 2 -2" /></svg><span>{% trans 'Participation fee: €5' %}</span></span>
									<span class="date-chip"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M5 3m0 3a3 3 0 0 1 3 -3h8a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-8a3 3 0 0 1 -3 -3z" /> <path d="M12 13m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /> <path d="M10 6h4" /> <path d="M9 18h6" /></svg><span>{% trans '* with a UBS, VVS or CAB membership card' %}</span></span>
								</div>
								<p class="open-warn mb-0"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M12 9v4" /> <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /> <path d="M12 16h.01" /></svg><span>{% trans 'ATTENTION! You must present your UBS, VVS or CAB membership card, which guarantees insurance coverage for this activity.' %}</span></p>
								<p class="dates-note mb-0"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M14 12v.01" /> <path d="M3 21h18" /> <path d="M6 21v-16a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v16" /></svg>
									<span>{% trans 'Door 7, then the blue door, down the stairs — follow the ropes.' %}</span></p>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- Rally teaser -->
{% if settings.rally_enabled %}
		<section class="section section-paper pt-0" aria-labelledby="rally-title">
			<div class="container">
				<div class="rally-band reveal">
					<div class="row g-0 align-items-stretch">
						<div class="col-lg-6 rally-band-media">
							<img src="/rally.webp" width="650" height="488" loading="lazy" decoding="async"
								alt="{% trans 'Rope courses rigged between the Basilica’s towers' %}"
								onerror="this.onerror=null;this.src='/img-fallback.svg';">
						</div>
						<div class="col-lg-6">
							<div class="rally-band-body">
								<p class="sticker sticker-cream mb-0">{% trans 'Every 3–4 years' %}</p>
								<h2 class="m-0" id="rally-title">{% trans 'Basilica caving rally' %}</h2>
{% if rally_date_label is not empty %}
								<p class="rally-date mb-0">{{ rally_date_label }}</p>
{% endif %}
								<p class="mb-0">{% trans 'A unique event, on and inside the Basilica. All details, the programme and registration live on the Rally page.' %}</p>
								<div>
									<a class="btn-yellow" href="/rallye/"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M3 19a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /> <path d="M19 7a2 2 0 1 0 0 -4a2 2 0 0 0 0 4z" /> <path d="M11 19h5.5a3.5 3.5 0 0 0 0 -7h-8a3.5 3.5 0 0 1 0 -7h4.5" /></svg><span>{% trans 'All the Rally details' %}</span></a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
{% endif %}

		<!-- Contact -->
		<section class="section section-cream" id="contact" aria-labelledby="contact-title">
			<div class="container">
				<div class="text-center mb-5">
					<p class="sticker sec-badge">{% trans 'Contact' %}</p>
					<h2 class="sec-title mx-auto" id="contact-title">{% trans 'Fancy coming down with us?' %}</h2>
					<p class="sec-lead mx-auto">{% trans 'The form below sends your message straight to the club — no spam, promise.' %}</p>
				</div>
				<div class="row g-4">
					<div class="col-lg-4">
						<div class="d-flex flex-column gap-3 h-100">
							<a class="contact-card" href="{{ settings.address_local_maps }}" target="_blank"
								rel="noopener">
								<svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /> <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" /></svg>
								<h3>{% trans 'Training facility address' %}</h3>
								<p><span>{{ settings.address_local_street }}</span><br>
									<span>{{ settings.address_local_zip }} {{ settings.address_local_city }}</span></p>
							</a>
							<a class="contact-card" href="{{ settings.address_club_maps }}" target="_blank"
								rel="noopener">
								<svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /> <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" /></svg>
								<h3>{% trans 'Club address' %}</h3>
								<p><span>{{ settings.address_club_street }}</span><br>
									<span>{{ settings.address_club_zip }} {{ settings.address_club_city }}</span></p>
							</a>
							<div class="d-flex gap-3 justify-content-center mt-auto pt-2">
								<a class="social-btn instagram" href="{{ settings.social_instagram }}"
									target="_blank" rel="noopener" aria-label="{% trans 'GS Redan on Instagram' %}"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M4 4m0 4a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z" /> <path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /> <path d="M16.5 7.5l0 .01" /></svg></a>
								<a class="social-btn facebook" href="{{ settings.social_facebook }}"
									target="_blank" rel="noopener" aria-label="{% trans 'GS Redan on Facebook' %}"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" /></svg></a>
							</div>
						</div>
					</div>
					<div class="col-lg-8">
						<form class="form-card" id="contact-form" method="post" action="/contact" novalidate>
							<p class="form-legend">{% trans 'Contact form' %}</p>
							<div class="row g-3">
								<div class="col-md-6">
									<label class="form-label" for="cf-name">{% trans 'Name' %}</label>
									<input class="form-control" id="cf-name" name="name" type="text" required
										autocomplete="name" placeholder="{% trans 'Your name' %}">
									<div class="invalid-feedback">{% trans 'This field is required.' %}</div>
								</div>
								<div class="col-md-6">
									<label class="form-label" for="cf-email">{% trans 'Email' %}</label>
									<input class="form-control" id="cf-email" name="email" type="email" required
										autocomplete="email" placeholder="{% trans 'you@example.com' %}">
									<div class="invalid-feedback">{% trans 'Hmm, that email address looks invalid.' %}</div>
								</div>
								<div class="col-12">
									<label class="form-label" for="cf-topic">{% trans 'Topic' %}</label>
									<select class="form-select" id="cf-topic" name="topic" required>
										<option value="">{% trans 'Choose a topic' %}</option>
										<option value="club">{% trans 'Join the club' %}</option>
										<option value="youth">{% trans 'Youth program' %}</option>
{% if settings.rally_enabled %}
										<option value="rally">{% trans 'Rally' %} {{ rally_year }}</option>
{% endif %}
										<option value="other">{% trans 'Something else' %}</option>
									</select>
									<div class="invalid-feedback">{% trans 'This field is required.' %}</div>
								</div>
								<div class="col-12">
									<label class="form-label" for="cf-message">{% trans 'Message' %}</label>
									<textarea class="form-control" id="cf-message" name="message" rows="5" required
										placeholder="{% trans 'Tell us everything (who you are, what you’d like to learn…)' %}"></textarea>
									<div class="invalid-feedback">{% trans 'Write at least a few words.' %}</div>
								</div>
								<div class="col-12">
									{# Honeypot: visually hidden and untabbable, with a
									   name no browser autofill profile matches (the
									   generic "website" token got autofilled by at
									   least one browser, which made the form look
									   broken). A human never fills it; a bot that
									   fills everything gets a silent redirect and
									   no mail. Not a translated string on purpose —
									   it is bait. #}
									<div class="d-none" aria-hidden="true">
										<label class="form-label" for="cf_website">Website</label>
										<input class="form-control" id="cf_website" name="cf_website" type="text"
											tabindex="-1" autocomplete="off">
									</div>
									{# Time trap: rendered server-side; a submission less
									   than three seconds after render is a bot. #}
									<input type="hidden" name="form_ts" value="{{ "now"|date("U") }}">
									<div class="form-check">
										<input class="form-check-input" id="cf-consent" name="consent" type="checkbox"
											required>
										<label class="form-check-label" for="cf-consent">{% trans 'I agree that my message and email address may be used only to answer my request (see the <a href="/legal/">privacy policy</a>).' %}</label>
										<div class="invalid-feedback">{% trans 'We can’t reply without it — please tick the box.' %}</div>
									</div>
								</div>
								<div class="col-12">
									<button class="btn-redan" type="submit"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M10 14l11 -11" /> <path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" /></svg> <span>{% trans 'Send the message' %}</span></button>
								</div>
							</div>
							{% if env.sticky_session.contact_sent is defined %}
								<p class="alert alert-redan mt-3 mb-0" role="status">{% trans 'Thanks! Your message is on its way — we answer as soon as we surface.' %}</p>
							{% endif %}
							{% if env.sticky_session.contact_error is defined %}
								<p class="alert alert-redan-error mt-3 mb-0" role="alert">{% trans 'Something went wrong while sending your message. Check the fields and try again.' %}</p>
							{% endif %}
							{% if env.sticky_session.contact_failed is defined %}
								<p class="alert alert-redan-error mt-3 mb-0" role="alert">{% trans 'Your message could not be sent — something went wrong on our side. Please try again later, or reach us on Instagram or Facebook.' %}</p>
							{% endif %}
							<p class="form-fallback"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /> <path d="M12 9h.01" /> <path d="M11 12h1v4h1" /></svg>
								<span>{% trans 'Trouble with the form? Try again, or reach us on Instagram or Facebook.' %}</span>
							</p>
						</form>
					</div>
				</div>
				<div class="row mt-4">
					<div class="col-12">
						<div class="map-wrap">
							<div id="map" class="leaflet-container" role="application" aria-label="{% trans 'Where to find us' %}"
								data-i18n-venue-popup="{% trans 'The training facility' %}"
								data-i18n-venue-l1="{{ settings.address_local_street }}"
								data-i18n-venue-l2="{{ settings.address_local_zip }} {{ settings.address_local_city }}"
								data-i18n-venue-link="{% trans 'Open in Google Maps' %}"
								data-i18n-club-popup="{% trans 'The club address' %}"
								data-i18n-club-l1="{{ settings.address_club_street }}"
								data-i18n-club-l2="{{ settings.address_club_zip }} {{ settings.address_club_city }}"
								data-i18n-club-link="{% trans 'Open in Google Maps' %}"></div>
						</div>
						<p class="text-center mt-2 mb-0"><small><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /> <path d="M12 9h.01" /> <path d="M11 12h1v4h1" /></svg>
								<span>{% trans 'Scroll zoom is off — drag the map to explore.' %}</span></small></p>
					</div>
				</div>
			</div>
		</section>
{% endblock content %}
