{% extends "_default/layout.public.twig" %}

{# All visual cards share the projects-section wrap of the original
   one-page: activity cards (any background/layout), the gallery and the
   calendar-fed Monday openings card. #}
{% set section_types = ['activities_light', 'activities_dark', 'activities_pair_light', 'activities_pair_dark', 'gallery', 'monday_openings'] %}

{% block content %}
	{% for block in blocks %}
		{% set is_section_block = block.type in section_types %}
		{% set previous = blocks[loop.index0 - 1] is defined ? blocks[loop.index0 - 1] : null %}
		{% set next = blocks[loop.index0 + 1] is defined ? blocks[loop.index0 + 1] : null %}

		{# Open the section when this is the first card of a section run. #}
		{% if is_section_block %}
			{% if previous is null or previous.type not in section_types %}
				<section class="projects-section bg-light">
					<div class="container px-4 px-lg-5">
			{% endif %}

			{% include "_block/" ~ block.type ~ ".twig" with {
				'block': block,
				'translation': block_translations[block.id],
				'settings': settings,
				'pictures': block_pictures[block.id] ?? [],
				'images': block_images,
				'pair_bodies': block_pair_bodies,
				'openings': block_openings ?? []
			} %}

			{# Close the section at the end of the run. #}
			{% if next is null or next.type not in section_types %}
					</div>
				</section>
			{% endif %}
		{% else %}
			{% include "_block/" ~ block.type ~ ".twig" with {
				'block': block,
				'translation': block_translations[block.id],
				'settings': settings,
				'pictures': block_pictures[block.id] ?? [],
				'images': block_images,
				'pair_bodies': block_pair_bodies,
				'openings': block_openings ?? []
			} %}
		{% endif %}
	{% endfor %}
{% endblock content %}
