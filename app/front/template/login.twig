{% extends "_default/layout.login.twig" %}
{% block content %}
	<div class="card card-md">
		<div class="card-body">
			<h2 class="h2 text-center mb-4">{% trans "Log in" %}</h2>
			{% if sticky_session.password_changed is defined %}
				<div class="alert alert-success" role="alert">
					{% trans "Your new password is saved. Log in with it below." %}
				</div>
			{% endif %}
			{% if sticky_session.logged_out is defined %}
				<div class="alert alert-success" role="alert">
					{% trans "You are logged out." %}
				</div>
			{% endif %}
			{% if sticky_session.reset_request_sent is defined %}
				<div class="alert alert-success" role="alert">
					{% trans "If that address belongs to an admin account, a reset link is on its way. It is valid once, for 24 hours." %}
				</div>
			{% endif %}
			{% if login_failed is defined and login_failed %}
				<div class="alert alert-danger" role="alert">
					{% trans "Invalid credentials." %}
				</div>
			{% endif %}
			{% if show_reset_request is defined and show_reset_request %}
				<form method="post" action="/login?action=reset_request" autocomplete="off">
					<div class="mb-3">
						<label class="form-label">{% trans "Email" %}</label>
						<input type="email" name="email" class="form-control" placeholder="{% trans "your@email.com" %}" autocomplete="username" required autofocus>
						<small class="form-hint">{% trans "Same answer whether or not the address is known." %}</small>
					</div>
					<div>
						<button type="submit" class="btn btn-primary w-100">
							{% trans "Send reset link" %}
						</button>
					</div>
					<div class="text-center mt-3">
						<a href="/login" class="link-secondary">{% trans "Back to log in" %}</a>
					</div>
				</form>
			{% else %}
				<form method="post" action="/login" autocomplete="off">
					<div class="mb-3">
						<label class="form-label">{% trans "Email" %}</label>
						<input type="email" name="login" class="form-control" placeholder="{% trans "your@email.com" %}" autocomplete="username" required autofocus>
					</div>
					<div class="mb-3">
						<label class="form-label">{% trans "Password" %}</label>
						<div class="input-group input-group-flat">
							<input type="password" name="password" id="login_password" class="form-control" placeholder="{% trans "Password" %}" autocomplete="current-password" required>
							<span class="input-group-text">
								<a href="#" class="link-secondary" data-toggle-password="#login_password" title="{% trans "Show password" %}" aria-label="{% trans "Show password" %}">
									<svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 12a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M21 12c-2.4 4.5-6.2 7-9 7s-6.6-2.5-9-7c2.4-4.5 6.2-7 9-7s6.6 2.5 9 7"/></svg>
								</a>
							</span>
						</div>
					</div>
					<div>
						<button type="submit" class="btn btn-primary w-100">
							{% trans "Log in" %}
						</button>
					</div>
					<div class="text-center mt-3">
						<a href="/login?action=reset_request" class="link-secondary">{% trans "Forgot your password?" %}</a>
					</div>
				</form>
			{% endif %}
		</div>
	</div>
{% endblock content %}