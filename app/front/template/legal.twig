{% extends "_default/layout.public.twig" %}

{% block page_title %}{{ 'Legal & privacy — GS Redan'|trans }}{% endblock page_title %}
{% block page_description %}{% trans 'Legal notice, privacy, cookies and photo credits of the Groupe Spéléo du Redan website (non-profit 0474.156.883, Brussels).' %}{% endblock page_description %}

{% block page_head %}
	<link rel="canonical" href="https://www.gsredan.be/legal/">
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="GS Redan">
	<meta property="og:title" content="{{ 'Legal & privacy — GS Redan'|trans }}">
	<meta property="og:description"
		content="{% trans 'Legal notice, privacy, cookies and photo credits of the Groupe Spéléo du Redan website (non-profit 0474.156.883, Brussels).' %}">
	<meta property="og:image" content="https://www.gsredan.be/caving-banner.webp">
	<meta property="og:url" content="https://www.gsredan.be/legal/">
	<meta property="og:locale" content="fr_BE">
	<meta property="og:locale:alternate" content="nl_BE">
	<meta property="og:locale:alternate" content="en_GB">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{{ 'Legal & privacy — GS Redan'|trans }}">
	<meta name="twitter:description"
		content="{% trans 'Legal notice, privacy, cookies and photo credits of the Groupe Spéléo du Redan website (non-profit 0474.156.883, Brussels).' %}">
	<meta name="twitter:image" content="https://www.gsredan.be/caving-banner.webp">
{% endblock page_head %}

{% block body_page %}legal{% endblock body_page %}

{% block content %}

		<!-- Page hero -->
		<section class="page-hero pb-4" aria-labelledby="legal-title">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-8 text-center">
						<p class="sticker sticker-teal sticker-lg">{% trans 'The serious bit (we promise)' %}</p>
						<h1 id="legal-title">{{ 'Legal & privacy'|trans }}</h1>
						<p class="sec-lead mx-auto mt-3">{% trans 'Everything the club has to say honestly about itself and your data. Promise, it’s shorter than a 40-metre ascent.' %}</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Publisher -->
		<section class="section section-paper" id="publisher" aria-labelledby="publisher-title">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-8">
						<h2 class="sec-title" id="publisher-title"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M15 21h-9a3 3 0 0 1 -3 -3v-1h10v2a2 2 0 0 0 4 0v-14a2 2 0 1 1 2 2h-2m2 -4h-11a3 3 0 0 0 -3 3v11" /> <path d="M9 7l4 0" /> <path d="M9 11l4 0" /></svg>
							<span>{% trans 'Publisher' %}</span></h2>
						<dl class="legal-facts">
							<dt>{% trans 'Name' %}</dt>
							<dd>{% trans 'Groupe Spéléo du Redan ASBL' %}</dd>
							<dt>{% trans 'Status' %}</dt>
							<dd>{% trans 'Non-profit organisation (ASBL)' %}</dd>
							<dt>{% trans 'Company number' %}</dt>
							<dd>{% trans '0474.156.883' %}</dd>
							<dt>{% trans 'Club address' %}</dt>
							<dd>{% trans 'Bd de Smet de Naeyer 21, 1090 Jette, Belgium' %}</dd>
							<dt>{% trans 'Contact' %}</dt>
							<dd><a href="/#contact" data-topic="other">{% trans 'Through the contact form' %}</a></dd>
							<dt>{% trans 'Website' %}</dt>
							<dd>www.gsredan.be</dd>
						</dl>
					</div>
				</div>
			</div>
		</section>

		<div class="container" aria-hidden="true">
			<hr class="rope-divider">
		</div>

		<!-- Privacy -->
		<section class="section section-cream" id="privacy" aria-labelledby="privacy-title">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-8">
						<h2 class="sec-title" id="privacy-title"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" /> <path d="M12 11m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /> <path d="M12 12l0 2.5" /></svg>
							<span>{% trans 'Privacy' %}</span></h2>
						<p>{% trans 'The contact form sends your message through our server to the club mailbox. Nothing is stored: the message is only forwarded by e-mail, and your address is used only to reply.' %}</p>
						<p>{% trans 'If you email us, we use your address only to reply and handle your request (membership, youth programme, Rally). We never sell or share your data with third parties.' %}</p>
						<p class="mb-0">{% trans 'You can ask for access, correction or deletion of your data at any time: use the contact form.' %}</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Cookies -->
		<section class="section section-paper" id="cookies" aria-labelledby="cookies-title">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-8">
						<h2 class="sec-title" id="cookies-title"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path stroke="none" d="M0 0h24v24H0z" /> <path d="M8 13v.01" /> <path d="M12 17v.01" /> <path d="M12 12v.01" /> <path d="M16 14v.01" /> <path d="M11 8v.01" /> <path d="M13.148 3.476l2.667 1.104a4 4 0 0 0 4.656 6.14l.053 .132a3 3 0 0 1 0 2.296q -.745 1.18 -1.024 1.852q -.283 .684 -.66 2.216a3 3 0 0 1 -1.624 1.623q -1.572 .394 -2.216 .661q -.712 .295 -1.852 1.024a3 3 0 0 1 -2.296 0q -1.203 -.754 -1.852 -1.024q -.707 -.292 -2.216 -.66a3 3 0 0 1 -1.623 -1.624q -.397 -1.577 -.661 -2.216q -.298 -.718 -1.024 -1.852a3 3 0 0 1 0 -2.296q .719 -1.116 1.024 -1.852q .257 -.62 .66 -2.216a3 3 0 0 1 1.624 -1.623q 1.547 -.384 2.216 -.661q .687 -.285 1.852 -1.024a3 3 0 0 1 2.296 0" /></svg>
							<span>{{ 'Cookies & local storage'|trans }}</span></h2>
						<p class="mb-0">{% trans 'This site sets no tracking cookies. The only cookie is the anonymous session cookie that carries your language choice between pages. Nothing else is stored on your device. We measure anonymous, cookie-free usage statistics with Umami; no personal data is collected.' %}</p>
					</div>
				</div>
			</div>
		</section>

		<div class="container" aria-hidden="true">
			<hr class="rope-divider">
		</div>

		<!-- Third parties -->
		<section class="section section-cream" id="third-party" aria-labelledby="third-party-title">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-8">
						<h2 class="sec-title" id="third-party-title"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M9.785 6l8.215 8.215l-2.054 2.054a5.81 5.81 0 1 1 -8.215 -8.215l2.054 -2.054z" /> <path d="M4 20l3.5 -3.5" /> <path d="M15 4l-3.5 3.5" /> <path d="M20 9l-3.5 3.5" /></svg>
							<span>{% trans 'Third-party services' %}</span></h2>
						<p>{% trans 'To work, the site loads resources from third parties: styles and scripts (jsDelivr), fonts (Google Fonts), icons (Tabler), map and tiles (Leaflet, OpenStreetMap). Those services see your IP address when loaded; their own privacy policies apply. Links to Google Maps and Instagram/Facebook also take you off this site.' %}</p>
						<ul class="list-unstyled d-grid gap-2">
							<li><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /> <path d="M11 13l9 -9" /> <path d="M15 4h5v5" /></svg>
								<a href="https://cdn.jsdelivr.net" target="_blank" rel="noopener">jsDelivr (Bootstrap,
									Tabler Icons)</a></li>
							<li><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /> <path d="M11 13l9 -9" /> <path d="M15 4h5v5" /></svg>
								<a href="https://fonts.google.com/about" target="_blank" rel="noopener">Google
									Fonts</a></li>
							<li><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /> <path d="M11 13l9 -9" /> <path d="M15 4h5v5" /></svg>
								<a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a></li>
							<li><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /> <path d="M11 13l9 -9" /> <path d="M15 4h5v5" /></svg>
								<a href="https://www.openstreetmap.org/copyright" target="_blank"
									rel="noopener">OpenStreetMap</a></li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- Disclaimer -->
		<section class="section section-paper" id="disclaimer" aria-labelledby="disclaimer-title">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-8">
						<h2 class="sec-title" id="disclaimer-title"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /> <path d="M12 8v4" /> <path d="M12 16h.01" /></svg>
							<span>{% trans 'Disclaimer' %}</span></h2>
						<p>{% trans 'Information (times, openings, dates) is provided in good faith and may change. When in doubt, check our social media or write to us before travelling.' %}</p>
						<p class="d-flex flex-wrap gap-3 align-items-center mt-4 mb-0">
							<span class="fw-bold">{% trans 'A question about this page?' %}</span>
							<a class="btn-redan" href="/#contact" data-topic="other"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M10 14l11 -11" /> <path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" /></svg> <span>{% trans 'Write to us' %}</span></a>
						</p>
					</div>
				</div>
			</div>
		</section>
{% endblock content %}
