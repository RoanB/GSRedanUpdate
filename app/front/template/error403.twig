{% extends "_default/layout.public.twig" %}

{# Nothing in the app routes here yet; the template is kept in step with the
   404 (same error-hero design) for the day a 403 path renders it. #}
{% block page_title %}{% trans 'Access denied (403) — GS Redan' %}{% endblock page_title %}
{% block page_description %}{% trans 'This page is closed to the public.' %}{% endblock page_description %}
{% block meta_robots %}noindex, follow{% endblock meta_robots %}
{% block theme_color %}#2E2019{% endblock theme_color %}

{% block body_page %}e403{% endblock body_page %}

{% block content %}

		<section class="error-hero" aria-labelledby="error-title">
			<div class="container">
				<div class="row justify-content-center align-items-center g-4">
					<div class="col-lg-4 text-center">
						<p class="error-code mb-0" aria-hidden="true">403</p>
					</div>
					<div class="col-lg-6">
						<p class="sticker sticker-lg">{% trans 'Error 403' %}</p>
						<h1 id="error-title">{% trans 'This gallery is closed…' %}</h1>
						<div class="error-card my-4">
							<p class="mb-0">{% trans 'The rope stops here: this page is restricted. You have to be roped up with us to enter.' %}</p>
						</div>
						<div class="d-flex flex-wrap gap-3">
							<a class="btn-yellow" href="/"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M12 5l0 14" /> <path d="M18 11l-6 -6" /> <path d="M6 11l6 -6" /></svg>
								<span>{% trans 'Back to daylight' %}</span></a>
							<a class="btn-ghost-light" href="/#contact" data-topic="other"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /> <path d="M3 7l9 6l9 -6" /></svg>
								<span>{% trans 'Report the missing page' %}</span></a>
						</div>
						<p class="mt-4 mb-2 d-flex flex-wrap gap-3 align-items-center">
							<a class="social-btn on-dark" href="{{ settings.social_instagram }}" target="_blank"
								rel="noopener" aria-label="{% trans 'GS Redan on Instagram' %}"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M4 4m0 4a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z" /> <path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /> <path d="M16.5 7.5l0 .01" /></svg></a>
							<a class="social-btn on-dark" href="{{ settings.social_facebook }}"
								target="_blank" rel="noopener" aria-label="{% trans 'GS Redan on Facebook' %}"><svg class="icon ti" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path stroke="none" d="M0 0h24v24H0z" fill="none"/> <path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" /></svg></a>
						</p>
						<p class="mb-0" style="color: rgba(255,249,239,.7);">
							<a href="/" style="color: var(--yellow); text-decoration: none; font-weight: 800;">GS
								Redan</a>
							· <span>{{ settings.footer_legal_entity|trans }} · {{ 'Company number:'|trans }} {{ settings.footer_company_number }}</span>
						</p>
					</div>
				</div>
			</div>
		</section>
{% endblock content %}

{% block scripts %}
	<script defer src="/main.js?v=20261019a"></script>
	{% include '_default/analytics.twig' %}
{% endblock scripts %}
