{% extends "_default/layout.members.twig" %}
{% import "_default/macro.tabler.twig" as tabler %}

{% block header_title %}{% trans "Members area" %} - GS Redan{% endblock header_title %}
{% block header_breadcrumb %}
	<li class="breadcrumb-item active">{% trans "Members area" %}</li>
{% endblock header_breadcrumb %}

{% block content %}
	{% if show_gate %}
		<div class="card card-md mx-auto mt-5" style="max-width: 28rem;">
			<div class="card-body">
				<h2 class="h2 text-center mb-3">{% trans "Members area" %}</h2>
				<p class="text-secondary text-center mb-4">{% trans "This area (files and the club calendar) is password protected. Enter the shared password." %}</p>
				{% if env.get.failed is defined %}
					<div class="alert alert-danger mb-3">{% trans "Wrong password, try again." %}</div>
				{% endif %}
				<form method="post" action="/members?action=gate">
					<div class="mb-3">
						<div class="input-group input-group-flat">
							<input type="password" name="password" id="members_password" class="form-control" placeholder="{% trans "Password" %}" autocomplete="current-password" required>
							<span class="input-group-text">
								<a href="#" class="link-secondary" data-toggle-password="#members_password">
									{{ tabler.icon('eye') }}
								</a>
							</span>
						</div>
					</div>
					<button type="submit" class="btn btn-primary w-100">
						{{ tabler.icon('lock') }} {% trans "Unlock" %}
					</button>
				</form>
			</div>
		</div>
	{% else %}
		<div class="row">
			<div class="col-lg-8">
				<div class="card">
					<div class="card-header">
						<div>
							<h3 class="card-title">{% trans "Files" %}</h3>
							<div class="card-subtitle mt-1">{% trans "Downloadable documents, sorted per category. Click a row to download." %}</div>
						</div>
						<div class="card-actions">
							<a href="/members?action=logout" class="btn btn-sm btn-outline-secondary">
								{{ tabler.icon('logout') }} {% trans "Log out" %}
							</a>
						</div>
					</div>
					{% for group in categories %}
						<div class="card-body pb-0 pt-3">
							{% if group.category %}
								<h4 class="text-secondary text-uppercase small mb-2">{{ group.category }}</h4>
							{% endif %}
						</div>
						{% if group.files|length > 0 %}
							<div class="list-group list-group-flush">
								{% for file in group.files %}
									<a class="list-group-item list-group-item-action d-flex align-items-center" href="/members?action=get&amp;id={{ file.id }}">
										{{ tabler.icon('file') }}
										<span class="ms-3 me-auto">{{ file.name }}</span>
										<span class="badge bg-secondary me-3 text-light">{{ file.size_label }}</span>
										{{ tabler.icon('download') }}
									</a>
								{% endfor %}
							</div>
						{% endif %}
					{% else %}
						<div class="card-body text-center text-secondary">
							{% trans "No files available." %}
						</div>
					{% endfor %}
				</div>
			</div>
			<div class="col-lg-4">
				<div class="card">
					<div class="card-header">
						<div>
							<h3 class="card-title">{% trans "Upcoming events" %}</h3>
							<div class="card-subtitle mt-1">{% trans "The next ten club events on the schedule." %}</div>
						</div>
					</div>
					{% if upcoming_events|length == 0 %}
						<div class="card-body text-center text-secondary">
							{% trans "No upcoming events." %}
						</div>
					{% else %}
						<ul class="list-group list-group-flush">
							{% for event in upcoming_events %}
								<li class="list-group-item">
									{{ tabler.icon('calendar') }}
									<span class="ms-2"><strong>{{ event.title }}</strong></span>
									<small class="d-block text-secondary ms-4">
										{{ event.starts_label }}
										{% if event.time_label is not empty %}
											• {{ event.time_label }}{% if event.ends_label is defined %}–{{ event.ends_label }}{% endif %}
										{% else %}
											• {% trans "all day" %}
										{% endif %}
										{% if event.location is not empty %} — {{ event.location }}{% endif %}
									</small>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
					<div class="card-footer">
						<a class="btn btn-outline-primary w-100" href="/members/calendar">
							{{ tabler.icon('calendar') }} {% trans "Open calendar" %}
						</a>
					</div>
				</div>
			</div>
		</div>
	{% endif %}
{% endblock content %}
